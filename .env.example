# Maintenance mode (build time). Set to "true" and redeploy to show the
# maintenance page on every route; remove it or set anything else and redeploy
# to restore the site. ETA is optional free text, e.g. "3:00 PM GMT".
# VITE_MAINTENANCE_MODE=true
# VITE_MAINTENANCE_ETA=
